{
  "name": "cac",
  "type": "module",
  "version": "7.0.0",
  "description": "Simple yet powerful framework for building command-line apps.",
  "author": "egoist <0x142857@gmail.com>",
  "maintainers": [
    "Kevin Deng <sxzz@sxzz.moe>"
  ],
  "license": "MIT",
  "homepage": "https://github.com/cacjs/cac#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cacjs/cac.git"
  },
  "bugs": {
    "url": "https://github.com/cacjs/cac/issues"
  },
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "workspaces": [
    "examples/browser"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "rolldown -c rolldown.config.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "node verify/differential.mjs ./src > /dev/null && echo differential-harness-ok",
    "validate": "npm run lint && npm run format:check && npm run test && npm run build"
  },
  "dependencies": {
    "mri": "^1.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.9.6",
    "rolldown": "^1.2.6",
    "tinyexec": "^1.3.0",
    "vitest": "^4.1.11"
  }
}
